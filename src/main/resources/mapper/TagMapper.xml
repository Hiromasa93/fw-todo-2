<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.todoapp.TagMapper">
    <insert id="insertIfAbsent">
        INSERT INTO tags (name) VALUES (#{name})
        ON DUPLICATE KEY UPDATE name = name
    </insert>
    <select id="findByName" resultType="com.example.todoapp.Tag">
        SELECT id, name FROM tags WHERE name = #{name}
    </select>
    <select id="search" resultType="com.example.todoapp.Tag">
        SELECT id, name FROM tags
        WHERE name LIKE #{pattern} ESCAPE '!'
        ORDER BY name, id LIMIT 20
    </select>
    <select id="findByIds" resultType="com.example.todoapp.Tag">
        SELECT id, name FROM tags
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                WHERE id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
            </when>
            <otherwise>WHERE 1 = 0</otherwise>
        </choose>
        ORDER BY name, id
    </select>
    <select id="findByTodoId" resultType="com.example.todoapp.Tag">
        SELECT t.id, t.name FROM tags t
        JOIN todo_tags tt ON tt.tag_id = t.id
        WHERE tt.todo_id = #{todoId} ORDER BY t.name, t.id
    </select>
    <delete id="deleteTodoTags">
        DELETE FROM todo_tags WHERE todo_id = #{todoId}
    </delete>
    <insert id="insertTodoTags">
        INSERT INTO todo_tags (todo_id, tag_id) VALUES
        <foreach collection="ids" item="id" separator=",">(#{todoId}, #{id})</foreach>
    </insert>
</mapper>
